{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mocap/skeleton-frame-v1.schema.json",
  "title": "SkeletonFrameV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "schema_version", "frame_time_us", "root_position_m", "joints", "segments", "missing_nodes", "stale_nodes", "synchronization_quality"],
  "properties": {
    "type": {"const": "skeleton.frame.v1"},
    "schema_version": {"const": 1},
    "frame_time_us": {"type": "integer", "minimum": 0},
    "root_position_m": {"$ref": "#/$defs/vector3"},
    "joints": {
      "type": "array",
      "items": {"$ref": "#/$defs/joint"}
    },
    "segments": {
      "type": "array",
      "items": {"$ref": "#/$defs/segment"}
    },
    "missing_nodes": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 14}, "uniqueItems": true},
    "stale_nodes": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 14}, "uniqueItems": true},
    "synchronization_quality": {"type": "number", "minimum": 0.0, "maximum": 1.0}
  },
  "$defs": {
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "quaternion": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["joint_id", "parent_joint_id", "position_m", "world_rotation_wxyz", "valid", "data_age_ms", "virtual"],
      "properties": {
        "joint_id": {"type": "string", "minLength": 1},
        "parent_joint_id": {"type": ["string", "null"]},
        "position_m": {"$ref": "#/$defs/vector3"},
        "world_rotation_wxyz": {"$ref": "#/$defs/quaternion"},
        "valid": {"type": "boolean"},
        "data_age_ms": {"type": "number", "minimum": 0.0},
        "virtual": {"type": "boolean"},
        "node_id": {"type": "integer", "minimum": 1, "maximum": 14}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "start_joint_id", "end_joint_id", "virtual"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1},
        "start_joint_id": {"type": "string", "minLength": 1},
        "end_joint_id": {"type": "string", "minLength": 1},
        "virtual": {"type": "boolean"}
      }
    }
  }
}
